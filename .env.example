# Memship Configuration
# Copy this file to .env and adjust as needed

# Image version (leave empty to build locally, or set to a version like 0.3.0)
# IMAGE_TAG=0.3.0

# Ports (defaults shown)
# HTTP_PORT=80
# HTTPS_PORT=443
# API_PORT=8003
# DB_PORT=5433

# Database
DB_PASSWORD=memship

# Security (CHANGE THIS in production!)
SECRET_KEY=change-me-in-production-use-a-random-64-char-string

# Application
APP_ENV=production
DEFAULT_LOCALE=es
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
# Public origin the browser reaches the API on. Caddy serves the API under
# /api/v1/* on the same host as the frontend, so this is normally the site URL.
# It is what the SSO callback URL is built from, so it must match the redirect
# URI registered with the provider exactly.
BACKEND_PUBLIC_URL=http://localhost

# Single sign-on (optional — leave blank to hide the provider's button)
# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: <BACKEND_PUBLIC_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Resend (preferred, managed delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Email — SMTP (alternative, self-hosted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@memship.local
SMTP_TLS=true

# Celery (Redis — included in Docker Compose)
# CELERY_BROKER_URL=redis://redis:6379/0
