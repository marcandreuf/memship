# Memship Configuration
# Copy this file to .env and adjust as needed
#
# On a server, prefer scripts/install.sh — it writes this file with real random
# secrets rather than the placeholders below, and creates the data directories.

# Image version (leave empty to build locally, or set to a version like 0.3.0)
# Pin an explicit release on a server so upgrades are deliberate.
# IMAGE_TAG=0.3.0

# Where persistent data lives on the host. Everything the stack must not lose —
# the database, uploads, the encryption key, TLS certificates, backups — sits
# under this one directory, so backing up memship is backing up this folder.
# Use an ABSOLUTE path on a server. Relative paths resolve against this file.
MEMSHIP_DATA_ROOT=./data

# Public address Caddy serves. Leave unset for plain HTTP on :80 (localhost).
# Set it to your hostname and Caddy provisions HTTPS automatically:
#   SITE_ADDRESS=memship.example.com
# The DNS A record must already resolve here and port 80 must be reachable —
# Let's Encrypt validates over HTTP before issuing.
SITE_ADDRESS=

# The backend containers run as this uid/gid rather than root, so uploads under
# MEMSHIP_DATA_ROOT/storage belong to you and are readable without sudo. Set
# these to your own ids (`id -u`, `id -g`); scripts/install.sh does it for you.
# Leaving them unset falls back to 1001, the user baked into the image.
HOST_UID=
HOST_GID=

# Ports (defaults shown)
# HTTP_PORT=80
# HTTPS_PORT=443
# API_PORT=8003
# DB_PORT=5433

# Database
DB_PASSWORD=memship

# Signs the session cookie and the member-card QR, and derives the key that
# encrypts stored payment-provider credentials. OPTIONAL: leave blank and the
# app generates a per-install key on first boot, persisting it to
# SESSION_KEY_FILE. Set it yourself for the strictest setup — a key that lives
# in .env survives a lost storage volume. Generate one with:
#   openssl rand -hex 32
# The old placeholder values are recognised and refused: they are published in
# this repository, so a session signed with one is forgeable by anyone.
SECRET_KEY=
# Where the auto-generated signing key is written when SECRET_KEY is blank.
# Blank -> <storage>/session.key. MUST be on a persistent volume.
SESSION_KEY_FILE=

# Secure attribute on the session cookie. Blank -> derived from the FRONTEND_URL
# scheme (https:// -> on), which is right for every normal deployment. Set it to
# true only if TLS is terminated somewhere the app cannot see, e.g. an upstream
# load balancer that talks plain HTTP to Caddy.
COOKIE_SECURE=

# Fernet key encrypting SSO provider secrets stored via the settings screen.
# OPTIONAL: leave blank and the app auto-generates a per-install key on first use,
# persisting it to SECRETS_KEY_FILE (never the database). Set this only to supply
# the key yourself, e.g. from a secrets manager. Generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MEMSHIP_SECRET_KEY=
# Where the auto-generated key is written when MEMSHIP_SECRET_KEY is unset.
# Blank -> <storage>/secret.key. MUST be on a persistent volume, or stored SSO
# secrets become unreadable after a restart.
SECRETS_KEY_FILE=

# Application
APP_ENV=production
DEFAULT_LOCALE=es
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
# Public origin the browser reaches the API on. Caddy serves the API under
# /api/v1/* on the same host as the frontend, so this is normally the site URL.
# It is what the SSO callback URL is built from, so it must match the redirect
# URI registered with the provider exactly.
BACKEND_PUBLIC_URL=http://localhost

# Single sign-on (optional — leave blank to hide the provider's button).
# These are FALLBACKS: a superadmin can instead configure SSO from Settings >
# Single sign-on, and any value set there overrides the matching var below.
# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: <BACKEND_PUBLIC_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com > Certificates, Identifiers & Profiles.
# APPLE_CLIENT_ID is the *Services ID* (e.g. com.example.memship.web), not the
# App ID. APPLE_PRIVATE_KEY is the contents of the .p8 "Sign in with Apple" key —
# paste it on one line with \n for the line breaks.
# Return URL: <BACKEND_PUBLIC_URL>/api/v1/auth/oauth/apple/callback
# Apple requires HTTPS and rejects localhost, so this only works on a real domain.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email — Resend (preferred, managed delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Email — SMTP (alternative, self-hosted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@memship.local
SMTP_TLS=true

# Celery (Redis — included in Docker Compose)
# CELERY_BROKER_URL=redis://redis:6379/0
