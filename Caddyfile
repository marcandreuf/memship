# Memship Caddy configuration
#
# The site address comes from SITE_ADDRESS, set in .env — you do not edit this
# file to go live. Leave it unset and Caddy serves plain HTTP on :80, which is
# what you want on localhost. Set it to your hostname:
#
#   SITE_ADDRESS=memship.example.com
#
# and Caddy provisions a Let's Encrypt certificate automatically and redirects
# HTTP to HTTPS. That requires the DNS A record to already resolve to this host
# and port 80 to be reachable from the internet — Let's Encrypt validates over
# HTTP. scripts/install.sh checks both before starting the stack.

{$SITE_ADDRESS::80} {
	# Backend API requests
	handle /api/v1/* {
		reverse_proxy api:8000
	}

	# No /uploads rule on purpose. Uploaded files reach the browser through the
	# frontend's /api/uploads proxy, which forwards the session cookie to the
	# API's authenticated uploads router. Routing /uploads straight at the API
	# used to bypass the frontend entirely, and back when that router was a
	# StaticFiles mount it handed out the encryption key and the SEPA files.

	# Everything else → frontend
	handle {
		reverse_proxy frontend:3000
	}
}
